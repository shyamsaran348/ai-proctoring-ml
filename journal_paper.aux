\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces System architecture. IDE~(ResNet-50) is shared across enrollment and per-frame processing. The immutable embedding~$e_0$ anchors IIM and LDD. PAM independently processes presence features. GAM, HGDM, and AAM handle gaze, pose-gaze dynamics, and acoustic monitoring. All seven signals converge at the RFE~(GRU) for temporal fusion into the session risk trajectory~$\rho _t$.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{7}{System architecture. IDE~(ResNet-50) is shared across enrollment and per-frame processing. The immutable embedding~$e_0$ anchors IIM and LDD. PAM independently processes presence features. GAM, HGDM, and AAM handle gaze, pose-gaze dynamics, and acoustic monitoring. All seven signals converge at the RFE~(GRU) for temporal fusion into the session risk trajectory~$\rho _t$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Temporal evidence flow. Seven individually noisy behavioral signals are processed by specialized temporal experts and fused by the GRU-based RFE into a smooth, high-confidence risk trajectory.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:flow}{{2}{7}{Temporal evidence flow. Seven individually noisy behavioral signals are processed by specialized temporal experts and fused by the GRU-based RFE into a smooth, high-confidence risk trajectory}{figure.2}{}}
